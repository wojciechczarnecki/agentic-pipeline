{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(gh api *)",
      "Bash(gh issue *)",
      "Bash(gh repo view*)",
      "Bash(gh auth status*)",
      "Bash(curl http://localhost*)",
      "Bash(curl * http://localhost*)",
      "Bash(curl * http://127.0.0.1*)",
      "Bash(bash scripts/*)",
      "Bash(scripts/*)",
      "Bash(./scripts/*)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(diff *)",
      "Bash(mkdir *)",
      "Bash(rm *)",
      "Bash(chmod +x *)",
      "Bash(date *)",
      "Bash(workflow_metrics.py *)",
      "Read(~/.claude/plugins/cache/TODO-marketplace/pipeline/**)",
      "WebSearch"
    ],
    "ask": [
      "Edit(**/.claude/settings*.json)",
      "Edit(**/.claude/workflow.json)",
      "Edit(**/scripts/git-hooks/**)"
    ],
    "deny": [
      "Bash(gh pr merge*)",
      "Bash(claude plugin disable*)",
      "Bash(claude plugin uninstall*)",
      "Bash(claude plugin remove*)",
      "Bash(claude plugin marketplace remove*)"
    ]
  },
  "extraKnownMarketplaces": {
    "TODO-marketplace": {
      "source": {
        "source": "git",
        "url": "TODO: https://github.com/<owner>/<repo>.git",
        "ref": "stable"
      }
    }
  }
}
