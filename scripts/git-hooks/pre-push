#!/usr/bin/env bash
# Git pre-push hook: nobody pushes to main directly — changes land through a squash-merged PR.
# Server-side branch protection is not always available (private repositories on free plans),
# so this is its local stand-in. Enable once per clone:
#   git config core.hooksPath scripts/git-hooks

protected='^refs/heads/(main|master)$'

receipt='plugin/evals/last-run.json'

# A minor or major release changes behaviour, so it does not go out without a green local
# eval run against the very commit being tagged. Patches are exempt: a full suite costs
# real money and a patch is usually a hook or a documentation fix. The eval never runs in
# CI (docs/DECISIONS.md, 2026-09-20), so this hook is the only place the rule can bite.
release_needs_eval() {
  local tag=${1#refs/tags/}
  [[ "$tag" =~ ^[a-z-]+--v([0-9]+)\.([0-9]+)\.([0-9]+)$ ]] || return 1
  [[ "${BASH_REMATCH[3]}" == "0" ]]
}

while read -r local_ref _local_sha remote_ref _remote_sha; do
  if [[ "$remote_ref" =~ $protected ]]; then
    echo "pre-push: direct push to ${remote_ref#refs/heads/} is blocked; open a PR instead." >&2
    exit 1
  fi

  if release_needs_eval "$remote_ref"; then
    tagged=$(git rev-list -n 1 "$local_ref" 2>/dev/null)

    if [[ ! -f "$receipt" ]]; then
      echo "pre-push: ${remote_ref#refs/tags/} is a minor or major release and there is no" >&2
      echo "pre-push: eval receipt. Run: bash scripts/eval.sh" >&2
      exit 1
    fi

    recorded=$(python3 -c 'import json;print(json.load(open("'"$receipt"'"))["plugin_fingerprint"])')
    green=$(python3 -c 'import json;print(json.load(open("'"$receipt"'"))["green"])')

    # The receipt ships inside the release it certifies, so it cannot name its own commit,
    # and a squash merge would invalidate any sha it did name. It fingerprints what plugin/
    # CONTAINS instead, which survives squashing, rebasing and a fresh clone.
    tagged_fingerprint=$(git ls-tree -r "$tagged" -- plugin/ |
      grep -v 'evals/last-run.json' | sha256sum | cut -d" " -f1)

    if [[ "$recorded" != "$tagged_fingerprint" ]]; then
      echo "pre-push: plugin/ changed since the eval ran." >&2
      echo "pre-push: re-run: bash scripts/eval.sh" >&2
      exit 1
    fi

    # `eval.sh --case X` writes a receipt too, and a one-case run is trivially green.
    # The release needs the whole suite, so count the cases that exist at the tag.
    expected=$(git ls-tree -r --name-only "$tagged" -- plugin/evals/ |
      grep -c '/case\.yaml$')
    counted=$(python3 -c 'import json;print(json.load(open("'"$receipt"'"))["cases_total"])')

    if [[ "$counted" != "$expected" ]]; then
      echo "pre-push: the receipt covers $counted case(s) but the suite has $expected." >&2
      echo "pre-push: run the whole suite: bash scripts/eval.sh" >&2
      exit 1
    fi

    # `eval.sh --runs 1` would measure a `runs: 3` case once, and one lucky run is not the
    # majority the case was set up for. Each case must have run as often as its case.yaml
    # at the tag asks (the CLI's default is 3).
    short=$(python3 - "$receipt" "$tagged" <<'PY'
import json, re, subprocess, sys

cases = json.load(open(sys.argv[1])).get("cases") or {}
listed = subprocess.run(
    ["git", "ls-tree", "-r", "--name-only", sys.argv[2], "--", "plugin/evals/"],
    capture_output=True, text=True,
).stdout.split()
for path in [p for p in listed if p.endswith("/case.yaml")]:
    text = subprocess.run(
        ["git", "show", f"{sys.argv[2]}:{path}"], capture_output=True, text=True
    ).stdout
    name = re.search(r"^name:\s*(\S+)", text, re.M)
    name = name.group(1) if name else path.split("/")[-2]
    wanted = re.search(r"^runs:\s*(\d+)", text, re.M)
    wanted = int(wanted.group(1)) if wanted else 3
    ran = (cases.get(name) or {}).get("runs") or 0
    if ran < wanted:
        print(f"{name} ran {ran} of {wanted}")
PY
)

    if [[ -n "$short" ]]; then
      echo "pre-push: the receipt ran fewer runs than case.yaml asks (--runs override?):" >&2
      echo "$short" | sed 's/^/pre-push:   /' >&2
      echo "pre-push: run the whole suite: bash scripts/eval.sh" >&2
      exit 1
    fi

    if [[ "$green" != "True" ]]; then
      echo "pre-push: the last eval run was not green; ${remote_ref#refs/tags/} is blocked." >&2
      exit 1
    fi

    # Consumers work on the session's default model, so that is the model a release is
    # measured on; a cheaper --model is for drafting cases, not for the gate.
    model=$(python3 -c 'import json;print(json.load(open("'"$receipt"'")).get("model", ""))')

    if [[ -z "$model" ]]; then
      echo "pre-push: the receipt does not record the model it ran on; re-run:" >&2
      echo "pre-push: bash scripts/eval.sh" >&2
      exit 1
    fi

    if [[ "$model" != "default" ]]; then
      echo "pre-push: the receipt was produced with --model $model; a release receipt runs" >&2
      echo "pre-push: on the default model. Re-run: bash scripts/eval.sh" >&2
      exit 1
    fi
  fi
done

exit 0
